<UserControl x:Class="KamiinaBotan.Views.StartMenuView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                 xmlns:local="clr-namespace:KamiinaBotan.Views"
                 xmlns:vm="clr-namespace:KamiinaBotan.ViewModels"
                 mc:Ignorable="d"
                 Height="720" Width="1280"
                 Background="AntiqueWhite">
    <UserControl.Resources>
        <Storyboard x:Key="ZoomAndFlashIn">
            <DoubleAnimation Storyboard.TargetName="StartScale" Storyboard.TargetProperty="ScaleX"
                             To="1.8" Duration="0:0:0.50">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="StartScale" Storyboard.TargetProperty="ScaleY"
                             To="1.8" Duration="0:0:0.50">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="TapText" Storyboard.TargetProperty="Opacity"
                             To="0" BeginTime="0:0:0.30" Duration="0:0:0.30"/>
            <DoubleAnimation Storyboard.TargetName="Flash" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" BeginTime="0:0:0.25" Duration="0:0:0.25"/>
        </Storyboard>
        <Storyboard x:Key="FlashOut">
            <DoubleAnimation Storyboard.TargetName="Flash" Storyboard.TargetProperty="Opacity"
                             From="1" To="0" BeginTime="0:0:0.01" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>
    
    <Grid>
        <Image  Source="{Binding BackgroundPath}"   d:Source="/images/StartScreen.jpg"/>

        <Grid x:Name="StartMenu" Visibility="{Binding IsStartVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock x:Name="TapText" Text="Tap to Start" FontSize="150" FontFamily="Reenie Beanie" FontWeight="Bold"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="30,0" RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <ScaleTransform x:Name="StartScale" ScaleX="1" ScaleY="1"/>
                </TextBlock.RenderTransform>
                <TextBlock.Foreground>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="#B8A4FF" Offset="0.25"/>
                        <GradientStop Color="#7CE7FF" Offset="0.5"/>
                        <GradientStop Color="#C58AFF" Offset="0.75"/>
                        <GradientStop Color="#FFB5E8" Offset="1"/>
                    </LinearGradientBrush>
                </TextBlock.Foreground>
                <TextBlock.Effect>
                    <DropShadowEffect Color="#A855F7" Opacity="0.9" BlurRadius="20" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>
        </Grid>

        <StackPanel x:Name="MainMenu" Margin="60,110,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" 
                    Visibility="{Binding IsStartVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Button Style="{StaticResource MenuButtonStyle}" Content="PLAY" Margin="0,0,0,100" Command="{Binding PlayCommand}"/>
            <Button Style="{StaticResource MenuButtonStyle}" Content="OPTIONS" Margin="0,0,0,100" Command="{Binding SettingsCommand}"/>
            <Button Style="{StaticResource MenuButtonStyle}" Content="EXIT" Margin="0,0,0,100" Command="{Binding ExitCommand}"/>
        </StackPanel>
        <Grid x:Name="ClickArea" Background="Transparent"
              Visibility="{Binding IsStartVisible, Converter={StaticResource BoolToVisibilityConverter}}"
              MouseLeftButtonDown="ClickArea_MouseLeftButtonDown"/>
        <Rectangle x:Name="Flash" Fill="White" Opacity="0" IsHitTestVisible="False"/>
    </Grid>
</UserControl>